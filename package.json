{
  "name": "reviewtrail",
  "version": "0.29.1",
  "private": true,
  "description": "Review code changes along cross-file behavior paths",
  "author": "backnotprop",
  "license": "MIT OR Apache-2.0",
  "bin": {
    "reviewtrail": "bin/reviewtrail"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:review": "bun run --cwd apps/review dev",
    "build:review": "bun run --cwd apps/review build",
    "build": "bun run build:review",
    "install:reviewtrail": "bun scripts/install-reviewtrail.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.303",
    "@opencode-ai/sdk": "1.19.3",
    "@pierre/diffs": "1.7.0-beta.3",
    "diff": "^8.0.4",
    "dockview-react": "^5.2.0",
    "dompurify": "^3.4.17",
    "marked": "^17.0.6",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@pierre/diffs-sem": "file:vendor/pierre-diffs/pierre-diffs-1.7.0-beta.3-sem.6.tgz",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "bun-types": "^1.4.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "dompurify": "^3.4.17",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "proxy-addr": "2.0.8",
    "katex": "^0.19.0"
  },
  "patchedDependencies": {
    "@opencode-ai/sdk@1.19.3": "patches/@opencode-ai%2Fsdk@1.19.3.patch",
    "@pierre/diffs@1.7.0-beta.3": "patches/@pierre%2Fdiffs@1.7.0-beta.3.patch",
    "@pierre/trees@1.0.0": "patches/@pierre%2Ftrees@1.0.0.patch"
  }
}
