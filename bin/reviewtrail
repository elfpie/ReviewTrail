#!/usr/bin/env bun
import { homedir } from 'node:os';
import { join } from 'node:path';
import { tokenizeReviewArgs } from '../packages/shared/review-args.ts';
import pkg from '../package.json';
import { REVIEW_HELP } from '../apps/review/server/cli.ts';

// Pi provides slash command arguments as a single string. Parse in the CLI
// so a standalone, auto-discovered extension needs no repository imports.
const fromPi = process.argv[2] === '--pi-command' && process.argv.length === 4;
const args = fromPi
  ? [...tokenizeReviewArgs(process.argv[3]), '--json']
  : process.argv.slice(2);
const wantsVersion = ['--version', '-v'].includes(args[0]);
if (wantsVersion || ['--help', '-h'].includes(args[0])) {
  const message = wantsVersion
    ? `ReviewTrail ${pkg.version}`
    : REVIEW_HELP;
  console.log(fromPi ? JSON.stringify({ decision: 'info', message }) : message);
  process.exit(0);
}

// Inherit the existing corporate policy overrides when the fork has no explicit setting.
const env = process.env;
for (const setting of ['TEST_SANDBOX', 'AI', 'PACKAGE_LOOKUP', 'GIT_REMOTE_CHECK', 'CLAUDE_SANDBOX',
  'PACKAGE_REGISTRY_URL', 'PACKAGE_DOWNLOADS_URL', 'BITBUCKET_API_URL']) {
  const upstream = env['PLANNOTATOR_' + setting];
  if (upstream !== undefined) env['REVIEWTRAIL_' + setting] ??= upstream;
}
// Child tools must never inherit another launcher's session or bridge credentials.
for (const name of Object.keys(env)) {
  if (name.startsWith('PLANNOTATOR_')) delete env[name];
}
env.REVIEWTRAIL_DATA_DIR = env.REVIEWTRAIL_DATA_DIR?.trim() || join(homedir(), '.reviewtrail');
env.REVIEWTRAIL_PORT = env.REVIEWTRAIL_PORT?.trim() || '0';
if (fromPi) env.REVIEWTRAIL_ORIGIN = 'pi';
process.argv.splice(2, process.argv.length - 2, 'review', ...args);
await import('../apps/review/server/index.ts');
